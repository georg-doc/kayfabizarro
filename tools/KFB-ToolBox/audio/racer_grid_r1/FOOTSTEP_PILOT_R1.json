  "contact_contract": {
    "emitter": "existing Animation Lab measured foot-contact entry, crossed normalized action phase, constrained by authoritative movement grounded/contact",
    "event_name": "kfb:motion-foot-contact (PROPOSAL)",
    "required_fields": [
      "actorId",
      "foot",
      "motionClip",
      "cycleIndex",
      "contactPhase",
      "worldFootPosition",
      "surfaceTag",
      "grounded",
      "actualSpeed",
      "contactLoad",
      "eventId"
    ],
    "optional_fields": [
      "blendWeight",
      "rigFamily",
      "verticalImpactSpeed",
      "travelMode"
    ],
    "motion_states": [
      "walk",
      "walk.fast",
      "run",
      "sprint",
      "backward",
      "strafe.left",
      "strafe.right",
      "jump.start",
      "jump.air",
      "jump.land"
    ],
    "event_rules": [
      "one event per foot when entering stance, not every frame",
      "only on grounded confirmed support and actual locomotion",
      "crossfade same-foot dedup, author one winning contact",
      "idle and airborne emit zero step sounds",
      "landing is single authoritative grounded transition, suppress nearby step",
      "surface sampled at exact contact, not global actor origin",
      "multi-surface blend only when authoritative surface weights exist",
      "animation event phase follows phase-synchronized clip and playbackRate; no hardcoded wall-clock footstep metronome"
    ],
    "soundSelection": "deterministic per-actor anti-repeat weighted sample draw; short source one-shots; L/R selection via event, not baked stereo alternating loops",
    "mix": "existing PLAYER_CRITICAL/WORLD_SFX bus through one AudioContext; avoid competing score/voice ducking owner"
  },
  "minimum_acceptance_fixture": {
    "actor": "Rig_Medium on flat source-backed support",
