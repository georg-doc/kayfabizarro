  "pipeline": [
    "load exact KayKit building_X.gltf",
    "clone per instance",
    "clayify each mesh with profile=house",
    "softenGeometry maxEdge=0.18 maxSubdivisions=3 maxTriangles=90000",
    "Taubin smooth lambda=0.5 mu=-0.53 iterations=8 preserveBorders=true",
    "normal lump amount=0.018 frequency=1.6",
    "seedGeometry before material",
    "clay material with original KayKit color atlas",
    "foot/scale/place",
    "only then apply approved height-dependent bend/torsion to roof and body together"
  ],
