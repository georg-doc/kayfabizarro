 },
 "rules": {
  "R1": {
   "text": "One OKLCH harmony rule, one generator: ground hue g carries the mood; strang/accent = g ± scheme angle on the warm side; landmark opposite, pulled into the candy band; leaf green, autumn on green/teal ground; sky = leaf + 90°; trunk/earth = leaf − 105°; lightness/chroma ladders with the anti-neon cap.",
   "source": "V-305 (DECISIONS.md, Hub col04 PASS) · replies/COLOR_HARMONY_R1/README.md §1–§3 · kfb-cartoon-palette.js fromHue()"
  },
  "R2": {
   "text": "The mood/story colour goes on the GROUND (60 % of the picture), lightness from the J17 ladder, not from a dark web colour.",
   "source": "V-305 (\"Story-Farbe bleibt auf dem Boden\") · COLOR_HARMONY_R1/README.md §3.7 (fromStoryMode)"
  },
  "R3": {
   "text": "Islands carry no story mode of their own; story-mode colours (V-292) are a later accent, not the ground. Here the ground hue comes from the island mood brief instead of a card.",
   "source": "V-342 (1) · V-292 (story-mode hexes, not used as ground)"
  },
  "R4": {
   "text": "Role grammar = ENV_ROLES (ground, grass, stone, bark, leaf, bloom, water, accent, sand, paved, earth), three tones light/mid/dark; the generator's envRoles output is this grammar, mapped 1:1 by material name kfb_role_<role>_<tone>.",
   "source": "Lab src/palettes.ts ENV_ROLES (read only) · COLOR_HARMONY_R1/README.md §3.8 (envRoles) · B27/RETURN.md (material names)"
  },
  "R5": {
   "text": "Ladders: light = +0.07 L (C × 0.95), dark = −0.09 L.",
   "source": "COLOR_HARMONY_R1/README.md §3.9 · MODEL.ladder"
  },
  "R6": {
   "text": "Proposal roles snow and cloud = the generator cream (Creme 80–84°, L 0.93, C ≈ 0.03) as a ladder, light end only (tones light, light, mid): the dark cream tone read as sand on Iceland (iter3). B27 fallback would be sand/paved.",
   "source": "COLOR_HARMONY_R1/README.md §2 (Wolke · Weg · Sand) · B27/RETURN.md (snow/cloud proposal)"
  },
  "R7": {
   "text": "Ground never a saturated green: no ground/grass tone with HSV hue 55–170° and saturation > 0.35 (moss, leaf, grass, lime under ACES).",
   "source": "50_BLENDER/SPEC/VORSCHLAG_BODENFARBE_R1.md rule 1 (WSB) · V-396 context"
  },
  "R8": {
   "text": "Chromatic-surreal six-colour rule: every object of a diorama may use any of the six colours of its zone palette; leaf/trunk/cloud/stone are defaults, not prohibitions (purple clouds, light-blue trunks, yellow crowns). No new hex set, V-305 stays the base.",
   "source": "CHANGELOG 2026-10-17 · V-421 R1.2 (register branch / PR #418, gh/research/v421-landmark-source-clay-proof-2026-10-17 commit 04cfdc7bb) · replies/V421_SOURCE_PROOF/LANDMARK_CHROMATIC_DIORAMA_STYLE_R1.md"
  },
  "R9": {
   "text": "Never neon: chroma capped (pop ≤ 0.195, field ≤ 0.14, rest ≈ 0.07, neutral ≈ 0.03) even where sRGB would allow more.",
   "source": "COLOR_HARMONY_R1/README.md §1 · MODEL.C"
  },
  "R10": {
   "text": "Fixed road/rim colours are not island roles here (asphalt #3d4a60, J17 bande) – not used by the B27 materials.",
   "source": "V-102 / V-174"
  }
 },
