  {
   "kind": "intro",
   "parts": [
    {
     "k": "frame",
     "t": "Big Bad Brain Wrestling: every move a lie, every bruise for real."
    }
   ]
  },
  {
   "kind": "intro",
   "parts": [
    {
     "k": "frame",
     "t": "Birthday present. Four heads."
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Click:"
    },
    {
     "k": "card",
     "t": "The Babyface, high-flying moves; audiences cheer, a slave to approval.",
     "n": 1
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Sister yawns:"
    },
    {
     "k": "card",
     "t": "The Heel, eye pokes; if they aren't booing, you aren't doing your job.",
     "n": 2
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Now she cheers:"
    },
    {
     "k": "card",
     "t": "The Tweener, you don't ask for it, so they want you more.",
     "n": 3
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Somebody loses:"
    },
    {
     "k": "card",
     "t": "The Jobber, isolated and picked apart; you exist to make the other guy look good.",
     "n": 4
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "So, fake it:"
    },
    {
     "k": "card",
     "t": "The Master Seller, reel back, limp to the ring, make them believe.",
     "n": 9
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Needs noise:"
    },
    {
     "k": "card",
     "t": "The Thigh Slap, a loud sound suggests high impact; an audio lie.",
     "n": 13
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Mom says no:"
    },
    {
     "k": "card",
     "t": "The Stomp Punch, kinetic misdirection.",
     "n": 14
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Fish tank!"
    },
    {
     "k": "card",
     "t": "The Oversell Clown, flying backwards from a gentle tap.",
     "n": 11
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Cereal box script:"
    },
    {
     "k": "card",
     "t": "The Booker, spider in suit; the ending is pre-planned, you are just a puppet.",
     "n": 45
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Class invited:"
    },
    {
     "k": "card",
     "t": "The Empty Arena, pausing for a pop that never comes.",
     "n": 30
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Dog on tape:"
    },
    {
     "k": "card",
     "t": "The Green Screen Crowd, audio sweetening on a lie.",
     "n": 31
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Cousin, online:"
    },
    {
     "k": "card",
     "t": "The Internet Smark, psychology without ever taking a bump.",
     "n": 53
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Real bite:"
    },
    {
     "k": "card",
     "t": "The Real Injury, unplanned; the crowd goes nuts because it's real.",
     "n": 35
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Shh, Mom:"
    },
    {
     "k": "card",
     "t": "The Kayfabe Police, keep the secrets secret, or get fired.",
     "n": 55
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "One arm left:"
    },
    {
     "k": "card",
     "t": "The Finisher, the Leg Drop; if this hits, go home.",
     "n": 41
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Slow count:"
    },
    {
     "k": "card",
     "t": "The False Finish, the art of the near-fall.",
     "n": 42
    }
   ]
  },
  {
   "kind": "card",
   "parts": [
    {
     "k": "bridge",
     "t": "Christmas:"
