 "herkunft": {
  "bezug.kies.fels, bezug.blume.fels, bezug.gras.fels": "gemessen, Dichte je m2 nach Abstand zum Felsrand, Kies über Korndichte auf Stücke umgerechnet",
  "seite.kappa, seite.winkel Fels": "gemessen, Resultante 0,82 und 0,86, Winkel Kies gegen Pflanzen 93 Grad",
  "stueck.adj kies-gras, kies-blume, gras-blume": "gemessen, nah 0,22, 0,27, 1,78",
