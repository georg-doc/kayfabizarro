{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kfb.track-module-look/1 schema proposal",
  "type": "object",
  "required": [
    "schema",
    "status",
    "geometryOwner",
    "lookOwner",
    "conversion",
    "referenceSection",
    "colorRoles",
    "modules",
    "searchProtocol"
  ],
  "properties": {
    "schema": {
      "const": "kfb.track-module-look/1"
    },
    "modules": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/mod"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "source",
        "lines"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "dim": {
      "type": "object",
      "required": [
        "name",
        "trackMeters",
        "labUnits",
        "source",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "trackMeters": {
          "type": "number"
        },
        "labUnits": {
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/ref"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "mod": {
      "type": "object",
      "required": [
        "id",
        "family",
        "section",
        "edge",
        "frames",
        "lookSource",
        "dimensions",
        "colorRoles",
        "materialLayers",
        "oneToOne",
        "sourceLimits",
        "marking",
        "evidence",
        "status",
        "skin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "family": {
          "enum": [
            "race",
            "world",
            "race/world",
            null
          ]
        },
        "lookSource": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dim"
          }
        },
        "status": {
          "enum": [
            "SOURCE_LOOK_SPEC_NOT_IMPLEMENTED",
            "SOURCE_INVENTORY_ONLY"
          ]
        },
        "skin": {
          "enum": [
            "race",
            "town",
            "country",
            "dirt",
            "trail",
            "cosmic"
          ]
        }
      }
    }
  }
}
