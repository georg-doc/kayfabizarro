 "scale": "1.0 = native GPT sheet pixels (relative scale untouched)",
 "anchor": {
  "x": 256,
  "y": 112,
  "rule": "x = horizontal bbox centre of the mouth. y: OPEN shapes put their upper-lip top edge (median over the central 16% of columns) on anchor.y = upper-lip top of closed, so the upper lip stays under the nose and the jaw opens downward. CLOSED shapes (anchor_mode seam) put their lip line on the lip line of closed (anchor.y + seam_offset).",
  "seam_offset": 54
 },
 "upperLift": {
  "value_baked": 0.0,
  "tested": [
   0.0,
   0.15
  ],
  "rule": "dy = -upperLift * extra_height_px, extra = max(0, h_shape - h_closed) measured from the upper-lip top (centre) to the lowest point; 0 for closed shapes. The upper lip rises by that share of the extra opening height, the rest goes down. PNGs are baked at 0; apply dy in the engine (lift_dy_px lists 0.15)."
 },
 "closed_height_px": 137,
 "closed_width_px": 309,
 "squash": {
  "factor": 0.8,
  "applied_when": "height_ratio_to_closed >= 1.8",
  "pivot": "upper-lip top (stays fixed)"
 },
