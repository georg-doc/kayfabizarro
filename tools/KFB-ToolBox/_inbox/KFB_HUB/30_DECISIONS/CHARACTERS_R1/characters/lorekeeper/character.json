    "speechPatterns": {
      "v": [
        {
          "text": "| Lorekeeper | bm_fable | 0,92 | britischer Erzähler |",
          "file": "KFB_HUB/30_DECISIONS/replies/VOICE_CASTING_R1.md",
          "line": 40,
          "heading": "KayKit-Figuren aus dem Eye-Rig-Batch (Medium 27, Large 4)"
        },
        {
          "text": "Je Feld 1–2 Kandidaten. Bereits vergeben: FrizzleBob Posaune mit Dämpfer, Dory Okarina, Hunky Fagott bzw. Kazoo, Farmer B Akkordeon, Lorekeeper tiefe Klarinette.",
