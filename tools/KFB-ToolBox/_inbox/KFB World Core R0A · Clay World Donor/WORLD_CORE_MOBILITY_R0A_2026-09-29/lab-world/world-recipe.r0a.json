  "meshTools": {
    "why": "Georg 29.09.: dents, notches, spatula and modelling traces in the MESH, organic and non-repetitive, to carry the handmade look together with the K2 material tools.",
    "scaleLogic": "Mesh carries forms >= 2 grid cells (>= 2.5 m); K2 material carries everything under the hand size (1.5 m). Size per stamp follows a power law (many small, few large), multiplied by the class scale.",
    "cell": 4.2,
    "distribution": "Worley-style jittered cells (cell 4.2 m), at most one stamp per cell, acceptance = density(low-frequency noise 1/65 m) x class weight. Orientation from a slow direction field (1/90 m), bent downhill on slopes. Seeded, deterministic, no tiling.",
    "protect": "Amplitude 0 on every protected traversal surface (roads, sidewalks, track core, pads, jump corridor); ramps to 1 over 2.5-7 m. Footpath keeps 25 %.",
    "classes": {
      "hill":   { "scale": 1.55, "weights": { "thumb": 0.34, "spatula": 0.38, "notch": 0.12, "pinch": 0.16 }, "density": 0.88 },
      "meadow": { "scale": 1.0,  "weights": { "thumb": 0.42, "spatula": 0.26, "notch": 0.07, "pinch": 0.25 }, "density": 0.74 },
      "seam":   { "scale": 0.7,  "weights": { "thumb": 0.18, "spatula": 0.52, "notch": 0.24, "pinch": 0.06 }, "density": 0.66, "note": "2.5-8 m next to protected surfaces: strokes run parallel to the edge like smoothing a seam" }
    },
    "stamps": {
      "thumb":   { "r": [2.0, 5.2], "depth": [0.14, 0.38], "rim": 0.32, "aspect": [0.65, 1.0] },
      "spatula": { "len": [5.0, 13.0], "w": [1.6, 3.2], "depth": [0.1, 0.24], "ridge": 0.55, "lift": 0.35 },
      "notch":   { "len": [3.0, 6.0], "w": [1.2, 2.0], "depth": [0.12, 0.28] },
      "pinch":   { "r": [1.4, 3.0], "h": [0.08, 0.22] }
    },
    "clamp": [-0.55, 0.4]
  },

