    "hips": [
      "rearLeft hip",
      "rearRight hip"
    ],
    "optionalBends": [
      "front elbows",
      "rear knees"
    ],
    "neck": "head follow pivot",
    "tail": "base pivot + optional secondary chain"
  },
  "neutralBind": {
    "rule": "Symmetric grounded quadruped bind pose derived from measured source parts; all four paws share a consumer-ground baseline unless source design explicitly requires otherwise."
  },
  "deformers": {
    "limbs": "small bend + stretch/squash around explicit shoulder/hip bones",
    "body": "restrained squash/stretch + lean",
    "head": "follow/tilt",
    "ears": "secondary motion if source-separated",
    "tail": "secondary motion if source-separated"
  },
  "eyeRig": {
    "protocol": "kfb.eye-rig.protocol/1",
    "attachment": "eyeFrame()"
  },
  "motionCandidates": [
    "neutral",
    "idle",
    "look",
    "walk",
    "trot",
    "sit",
    "hop",
    "shake",
    "react-positive",
    "react-negative"
  ],
  "ownership": {
    "actorModule": "local cutout presentation only",
    "consumer": "world motion, collision, navigation, camera, gameplay and persistence"
  },
  "forbiddenAssumptions": [
    "Do not infer Doccy proportions from a generic dog.",
    "Do not invent paws/ears/tail if the source does not separate them.",
    "Do not force human/biped gait timings onto the quadruped.",
    "Do not replace source artwork with KayKit/3D geometry."
