      "semanticBusGainDb": {
        "SCORE": -7,
        "DIEGETIC_MUSIC": -8,
        "LOCAL_AMBIENCE": -6,
        "GLOBAL_BED": -8
      },
      "futureStemTargets": {
        "bass": 0.64,
        "harmony": 0.55,
        "percussion": 0.24,
        "texture": 0.48
      },
      "promptReference": {
        "label": "KFB Conversation Style D",
        "path": "tools/KFB-Audio-Site/prompts/KFB_MUSIC_CONTEXT_STYLES_BCD_v1.md",
        "anchor": "kfb-conversation-style-d-base"
      }
    }
  },
  "adapter": {
    "manualControl": true,
    "method": "window.KFBAudioSite.musicContext.setState(stateId, options)",
    "snapshotMethod": "window.KFBAudioSite.musicContext.getSnapshot()",
    "inboundEvent": "kfb:music-context",
    "outboundEvent": "kfb:music-context-change",
    "voiceFocusEvent": "kfb:voice-focus",
    "payloadExample": {
      "state": "D",
      "source": "world-context-adapter",
      "reason": "resident-dialogue",
      "context": {
        "residentId": "example-only-runtime-supplied",
        "poiId": "example-only-runtime-supplied"
      }
    },
    "priorityHint": [
      "active addressed dialogue -> D",
      "meaningful movement/adventure -> B",
      "staying/exploration/POI linger -> C"
    ]
  },
  "worldIntegration": {
    "status": "PREPARED_NOT_INTEGRATED",
    "nextConsumer": "one of the next playable World MVP slices",
    "billboardHints": [
      "drive-by or movement billboard context may remain B",
      "POI / billboard linger may suggest C",
      "talking billboard, Resident or ChatterBox exchange may suggest D"
    ],
    "rule": "World/Resident/Billboard owners emit context only. The existing audio owner resolves targets and transitions."
  }
}
