# Repository-internal material is not part of the public Cloudflare surface.
.git/
.github/
skills/
_handoff/
tools/KFB-ToolBox/_inbox/
tools/**/_handover/

# Bulk source libraries remain canonical in GitHub and are indexed by the
# Asset Librarian, but they are not part of the small public Pages website.
media/2D_Assets/
media/3D_Assets/

# Documentation and editable source formats stay in GitHub, not in the static deploy.
**/*.md
**/*.docx
**/*.zip
**/*.blend
**/*.psd
**/*.aseprite
**/*.fbx
**/*.obj
**/*.mtl
**/*.dae
**/*.c3p
**/*.capx
