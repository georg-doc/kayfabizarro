   "lufs": -20.2,
   "gainDb": 4.2
  },
  {
   "id": "kb_rolle_06",
   "sec": "rolle",
   "text": "That's how we sold it in the old days. Spin, smile, hope.",
   "seconds": 4.62,
   "lufs": -20.0,
   "gainDb": 4.0
  },
  {
   "id": "kb_rolle_07",
   "sec": "rolle",
   "text": "Land it clean and nobody asks questions.",
   "seconds": 3.44,
   "lufs": -19.4,
   "gainDb": 3.4
  },
  {
   "id": "kb_rolle_08",
   "sec": "rolle",
   "text": "Bump of the year, kid. Bump of the year.",
   "seconds": 3.46,
   "lufs": -16.2,
   "gainDb": 0.2
  },
  {
   "id": "kb_crash_01",
   "sec": "crash",
   "text": "That's a ten-count. I'm getting up at nine.",
