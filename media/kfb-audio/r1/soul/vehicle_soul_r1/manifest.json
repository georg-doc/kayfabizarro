   "lufs": -25.7,
   "gainDb": 9.7
  },
  {
   "id": "kb_crash_05",
   "sec": "crash",
   "text": "We meant to do that. Say it with me.",
   "seconds": 3.22,
   "lufs": -19.0,
   "gainDb": 3.0
  },
  {
   "id": "kb_crash_06",
   "sec": "crash",
   "text": "Sell it, kid! Limp a little!",
