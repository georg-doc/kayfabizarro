   "lufs": -18.8,
   "gainDb": 2.8
  },
  {
   "id": "kb_sprung_01",
   "sec": "sprung",
   "text": "Whoa, kid! Take it easy!",
   "seconds": 2.66,
   "lufs": -17.9,
   "gainDb": 1.9
  },
  {
   "id": "kb_sprung_02",
   "sec": "sprung",
   "text": "That landing rearranged my fillings.",
   "seconds": 2.66,
   "lufs": -19.7,
   "gainDb": 3.7
  },
  {
   "id": "kb_sprung_03",
   "sec": "sprung",
   "text": "Top rope, kid! Nobody tries that sober.",
