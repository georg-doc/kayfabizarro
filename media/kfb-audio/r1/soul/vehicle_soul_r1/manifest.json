   "lufs": -18.1,
   "gainDb": 2.1
  },
  {
   "id": "kb_crash_07",
   "sec": "crash",
   "text": "Note to self. Walls don't move.",
   "seconds": 3.88,
   "lufs": -21.3,
   "gainDb": 5.3
  },
  {
   "id": "kb_crash_08",
   "sec": "crash",
   "text": "And that's why they call me Old Dents.",
