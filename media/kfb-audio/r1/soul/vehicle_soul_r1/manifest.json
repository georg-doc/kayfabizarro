   "lufs": -17.3,
   "gainDb": 1.3
  },
  {
   "id": "kb_sprung_04",
   "sec": "sprung",
   "text": "Hit the ground like a stunt double nobody paid.",
   "seconds": 3.78,
   "lufs": -19.1,
   "gainDb": 3.1
  },
  {
   "id": "kb_sprung_05",
   "sec": "sprung",
   "text": "My suspension just filed a complaint.",
   "seconds": 3.22,
   "lufs": -21.6,
   "gainDb": 5.6
  },
  {
   "id": "kb_sprung_06",
   "sec": "sprung",
   "text": "Air time! The crowd goes mild.",
   "seconds": 3.34,
   "lufs": -17.9,
   "gainDb": 1.9
  },
  {
   "id": "kb_sprung_07",
   "sec": "sprung",
   "text": "Ten points for height. Minus nine for the landing.",
   "seconds": 4.1,
   "lufs": -19.3,
   "gainDb": 3.3
  },
  {
   "id": "kb_sprung_08",
   "sec": "sprung",
   "text": "Next time warn me. I'll hold my breath.",
   "seconds": 2.86,
   "lufs": -20.6,
   "gainDb": 4.6
  },
  {
   "id": "kb_rolle_01",
   "sec": "rolle",
   "text": "Yeah! This old beast was built for maximum Kayfabe speed!",
   "seconds": 4.16,
   "lufs": -17.6,
   "gainDb": 1.6
  },
  {
   "id": "kb_rolle_02",
   "sec": "rolle",
   "text": "Barrel roll! Even my hubcaps got dizzy.",
   "seconds": 3.38,
   "lufs": -17.3,
   "gainDb": 1.3
  },
  {
   "id": "kb_rolle_03",
   "sec": "rolle",
   "text": "Did we just do that on purpose?",
   "seconds": 2.68,
   "lufs": -22.2,
   "gainDb": 6.2
  },
  {
   "id": "kb_rolle_04",
   "sec": "rolle",
   "text": "Show-off. I love it.",
