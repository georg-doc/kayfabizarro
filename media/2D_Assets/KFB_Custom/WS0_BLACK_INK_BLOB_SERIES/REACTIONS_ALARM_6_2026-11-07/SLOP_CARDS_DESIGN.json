          "status": "DESIGN"
        },
        "backstory": {
          "v": "Basil raises an eyelid whenever HyperNorm supplies a fact that does not fit his morning. His usual categories are obvious and obviously mistaken. The Men in Black approve the distinction; Hunky and Dory issue examples. A dissonant card recently made him say he did not know. Nobody confiscated his collar. He now keeps one small interval between seeing something and explaining why it cannot be there.",
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "FrizzleBob: He doubts his eyes. They have requested a second opinion.",
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "emotion": {
          "v": "incredulous",
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        }
      }
