          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "stimme": {
          "v": {
            "vorschlag": "English breathy tenor, words arriving slightly after the reaction",
            "audio": null
          },
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "rufe": {
          "v": [
            "Was that included?",
            "I was not expecting the unexpected."
          ],
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "beziehung": {
          "v": {
            "paar_mit": null,
            "zustand_von": null,
            "family": "WSA_REACTIONS_ALARM_20261107"
          },
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "backstory": {
          "v": "Stanley keeps the HyperNorm landing classified as quiet until a noise makes this administratively difficult. He used to report unsettling cards before reading them. The Men in Black called that prudent; Hunky and Dory called it efficient. After the latest crash he found another resident just as frightened. They now check on each other before deciding what the noise means.",
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "FrizzleBob: Nothing has been confirmed. His eyebrows have responded independently.",
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "emotion": {
          "v": "startled",
          "src": "REACTIONS_ALARM_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        }
      }
    },
