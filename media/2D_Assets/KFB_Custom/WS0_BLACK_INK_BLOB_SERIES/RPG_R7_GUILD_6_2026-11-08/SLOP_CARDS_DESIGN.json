          "status": "DESIGN"
        },
        "backstory": {
          "v": "Bruno was employed to cut through red tape. The first office thanked him. The second asked for its door back.",
          "src": "RPG_R7_GUILD_6_2026-11-08/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "He has been asked to handle matters more delicately. He sharpened the smaller edge.",
          "src": "RPG_R7_GUILD_6_2026-11-08/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "emotion": {
          "v": "Head tilted back, eyes up and a loud triumphant laugh.",
          "src": "RPG_R7_GUILD_6_2026-11-08/CHARACTER_INTENT.json",
          "status": "DESIGN"
        }
      }
