          "status": "DESIGN"
        },
        "backstory": {
          "v": "Federmaß keeps a HyperNorm doorway under the protection of his round shield. A card proposing that firmness can include doubt receives his slowest stare: a position is either held or lost. Men in Black praise his composure. He has left the arrow in his own shield because removing evidence would look less authoritative.",
          "src": "WESTERN_WARRIORS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Der Standpunkt hält. Die Ursache steckt noch darin.",
          "src": "WESTERN_WARRIORS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
      }
    },
