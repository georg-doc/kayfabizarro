        },
        "backstory": {
          "v": "Vera measures every disagreement against an imaginary straight line through her HyperNorm window. A card suggesting that intention and outcome can diverge must be badly aimed. Hunky & Dory admire her precision and keep moving the target. She carries the blunt arrow separately, preserving one small interval in which she can still reconsider.",
          "src": "WESTERN_WARRIORS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Die Zielsetzung ist abgeschlossen. Das Ziel wurde inzwischen versetzt.",
          "src": "WESTERN_WARRIORS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
