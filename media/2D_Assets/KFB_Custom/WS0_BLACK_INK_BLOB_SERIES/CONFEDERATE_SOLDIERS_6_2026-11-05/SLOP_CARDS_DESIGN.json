        "backstory": {
          "v": "Vorratsrecht keeps her HyperNorm ration tin firmly shut and the key conspicuously available. A card suggesting that a reserve becomes useful when opened is filed as premature consumption: provisions are either accounted for or lost. Men in Black appreciate her control. She occasionally listens to the box, hoping that its contents have learned to justify themselves.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Der Bestand ist gesichert. Über seine Verwendung liegen keine Angaben vor.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
