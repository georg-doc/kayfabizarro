          "status": "DESIGN"
        },
        "backstory": {
          "v": "Säbelmut treats every HyperNorm corridor as the beginning of a splendid manoeuvre. A card allowing hesitation to count as courage makes her grin widen: movement is either forward or an explanation. Hunky & Dory reward her initiative with another assignment. She keeps the saber close enough to her own body that the plan still has room to change.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Der Aufbruch war überzeugend. Die Richtung wird nachgetragen.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
      }
    },
