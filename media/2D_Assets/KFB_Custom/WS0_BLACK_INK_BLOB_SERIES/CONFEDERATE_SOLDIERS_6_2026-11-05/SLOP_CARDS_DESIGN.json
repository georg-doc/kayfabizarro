      "id": "WSA_CONFEDERATE_SOLDIER_20261105_01",
      "name": "General Fernlage",
      "karte": {
        "persoenlichkeit": {
          "v": "He expects the distant situation to improve out of respect for his rank.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "haltung": {
