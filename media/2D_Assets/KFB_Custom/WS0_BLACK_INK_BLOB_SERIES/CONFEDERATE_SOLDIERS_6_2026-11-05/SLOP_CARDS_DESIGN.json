          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "backstory": {
          "v": "Fernlage watches the HyperNorm courtyard through an instrument he rarely raises. A card proposing that rank cannot settle distance receives his heaviest lower lip: the situation is either under command or improperly situated. Men in Black demand a clear overview. He polishes the spyglass while waiting for events to arrange themselves into something he can approve.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Der Überblick wird erwartet. Das Fernrohr ist bereits vorhanden.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
      }
    },
    {
      "id": "WSA_CONFEDERATE_SOLDIER_20261105_02",
      "name": "Feldwebelin Säbelmut",
      "karte": {
