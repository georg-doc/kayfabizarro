        },
        "backstory": {
          "v": "Kugelpflicht carries a cannonball through HyperNorm meetings as if it were the only item whose weight had been honestly declared. A card proposing that responsibility can be shared earns a tired sideways grimace. Hunky & Dory praise his dependability. He keeps the rammer handy, although the corridor has never supplied anything that it can usefully clear.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Die Verantwortung wurde gewogen. Sie bleibt bei ihm.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
