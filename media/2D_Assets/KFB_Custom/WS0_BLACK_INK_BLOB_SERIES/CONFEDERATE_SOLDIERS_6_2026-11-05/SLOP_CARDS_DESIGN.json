          "status": "DESIGN"
        },
        "backstory": {
          "v": "Zündverzug hugs his old musket beside the HyperNorm stairwell and listens for permission to relax. A card suggesting that readiness can include doubt leaves him staring at the lock: equipment is either safe or about to become his responsibility. Men in Black call this vigilance. He suspects that a canteen ought to make the job feel less dry.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Die Bereitschaft hält. Der Beteiligte bittet um Abstand.",
          "src": "CONFEDERATE_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
      }
