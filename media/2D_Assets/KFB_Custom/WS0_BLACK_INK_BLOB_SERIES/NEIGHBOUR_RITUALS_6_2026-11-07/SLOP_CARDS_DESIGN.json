          },
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "backstory": {
          "v": "Vera keeps a small wooden wedge for doors that HyperNorm says must remain firmly shut. She distinguishes between unnecessary conflict and necessary air. The Men in Black call that an untidy classification; Hunky and Dory would prefer a louder answer they could quote. A dissonant card gave her a third possibility: disagree without declaring an enemy. She has been practising on the landing, where several neighbours have started staying for the conversation.",
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "FrizzleBob: The objection was quiet. It is still there.",
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        }
      }
