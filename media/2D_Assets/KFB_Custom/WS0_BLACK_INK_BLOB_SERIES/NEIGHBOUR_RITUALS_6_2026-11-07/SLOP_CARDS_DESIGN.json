          "status": "DESIGN"
        },
        "stimme": {
          "v": {
            "vorschlag": "English firm alto, pride with a small anxious catch",
            "audio": null
          },
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "rufe": {
          "v": [
            "I had nearly finished.",
            "You need not make a thing of it."
          ],
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "beziehung": {
          "v": {
