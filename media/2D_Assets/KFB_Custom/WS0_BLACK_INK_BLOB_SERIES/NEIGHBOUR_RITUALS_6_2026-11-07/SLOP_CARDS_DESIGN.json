          "status": "DESIGN"
        },
        "rufe": {
          "v": [
            "Someone is expected. Me, possibly.",
            "This is being kept free."
          ],
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "beziehung": {
          "v": {
