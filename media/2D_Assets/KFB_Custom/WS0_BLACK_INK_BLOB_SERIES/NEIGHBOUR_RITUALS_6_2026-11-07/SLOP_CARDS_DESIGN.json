          "status": "DESIGN"
        },
        "backstory": {
          "v": "Egon carries a measuring tape because numbers make unsolicited advice look like a service. HyperNorm divides conversations into explaining and being explained to. The Men in Black keep him supplied with conclusions; Hunky and Dory admire his helpfulness from a safe distance. A contradictory card once asked whether he had heard the question. He now pauses occasionally. The neighbours are unsure whether this is progress or a technical fault.",
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "FrizzleBob: He knows the answer. A suitable question will turn up.",
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        }
      }
