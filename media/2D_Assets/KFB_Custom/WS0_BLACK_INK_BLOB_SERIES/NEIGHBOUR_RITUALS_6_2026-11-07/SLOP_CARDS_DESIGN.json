          "status": "DESIGN"
        },
        "backstory": {
          "v": "Mr. Justthisonce issues small permissions in the HyperNorm stairwell. His blank ticket means that a reason has been considered, even when it has not been written down. The Men in Black request consistent refusals; Hunky and Dory request impressive totals. A difficult card has made him notice the people behind the requests. He still describes every favour as a one-off. The building has become surprisingly full of one-offs.",
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "FrizzleBob: It remains an exception. Like all the others.",
          "src": "NEIGHBOUR_RITUALS_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        }
      }
