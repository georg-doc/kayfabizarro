      "id": "WSA_REACTIONS_CONTACT_ACTOR_20261107_01",
      "name": "Grace Afterall",
      "language": "en",
      "karte": {
        "persoenlichkeit": {
          "v": "She has just discovered that the worst possibility was not compulsory.",
          "src": "REACTIONS_CONTACT_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "haltung": {
          "v": "verwirrt",
