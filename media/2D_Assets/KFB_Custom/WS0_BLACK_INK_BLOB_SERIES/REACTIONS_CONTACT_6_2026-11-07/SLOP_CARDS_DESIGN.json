            "bewohner": {
              "gebaeude": "HyperNorm",
              "decks": []
            }
          },
          "src": "REACTIONS_CONTACT_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "stimme": {
          "v": {
            "vorschlag": "English warm mezzo, a breathy laugh after tension",
            "audio": null
          },
          "src": "REACTIONS_CONTACT_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "rufe": {
          "v": [
            "Oh. We are all right.",
            "I can breathe that bit again."
          ],
          "src": "REACTIONS_CONTACT_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "beziehung": {
          "v": {
            "paar_mit": null,
            "zustand_von": null,
            "family": "WSA_REACTIONS_CONTACT_20261107"
          },
          "src": "REACTIONS_CONTACT_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "backstory": {
          "v": "Grace spent the HyperNorm inspection expecting a fault serious enough to explain her worry. The Men in Black found none; Hunky and Dory advised continued readiness. A dissonant card asked whether she could stop preparing for a moment. She laughed before deciding if this was permitted. Now she keeps a handkerchief for tears, dust and the small undignified noise that relief sometimes makes.",
          "src": "REACTIONS_CONTACT_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "FrizzleBob: The crisis is over. Her shoulders have received the news.",
          "src": "REACTIONS_CONTACT_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "emotion": {
          "v": "relieved",
          "src": "REACTIONS_CONTACT_6_2026-11-07/CHARACTER_INTENT.json",
          "status": "DESIGN"
        }
      }
    },
