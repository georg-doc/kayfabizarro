          "status": "DESIGN"
        },
        "backstory": {
          "v": "Atemreserve supplies the HyperNorm stairwell with a call whose conclusion is always nearly ready. A card suggesting that silence might also communicate makes his cheeks swell: an assembly is either summoned or absent. Hunky & Dory expect another clear signal. He holds the breath a moment longer, privately enjoying the interval before anyone has to obey.",
          "src": "UNION_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Der Aufruf befindet sich noch im zuständigen Atemraum.",
          "src": "UNION_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
      }
    },
