        "backstory": {
          "v": "Erdschwere waits in the HyperNorm corridor with the spade already accounted for. A card proposing that progress need not leave a hole earns his heaviest lower lip: ground is either prepared or somebody else's unfinished assignment. Men in Black request a solid foundation. He rests on the shaft while deciding whether their metaphor deserves excavation.",
          "src": "UNION_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Die Grundlage wurde angefordert. Das Loch gilt noch als Vorschlag.",
          "src": "UNION_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
