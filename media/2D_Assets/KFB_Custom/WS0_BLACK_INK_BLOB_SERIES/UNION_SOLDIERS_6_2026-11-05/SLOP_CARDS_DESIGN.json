          "src": "UNION_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "backstory": {
          "v": "Schlusswort keeps the HyperNorm residents in formation with orders she has not yet unrolled. A card proposing that a decision can remain open receives her most conclusive stare: a matter is either settled or insubordinate. Men in Black admire her firmness. She presses the paper shut, leaving the actual wording free to surprise everybody later.",
          "src": "UNION_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "Der Beschluss steht fest. Sein Inhalt bleibt zusammengerollt.",
          "src": "UNION_SOLDIERS_6_2026-11-05/PRODUCTION_RECORD.json",
          "status": "DESIGN"
        }
      }
    },
