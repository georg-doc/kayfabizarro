          "status": "DESIGN"
        },
        "frizzlebob": {
          "v": "All five witnesses were present. Unfortunately they shared a body.",
          "src": "ALIENS_R6_CONTACT_6_2026-11-08/CHARACTER_INTENT.json",
          "status": "DESIGN"
        },
        "emotion": {
          "v": "Five raised eyes and a pinched, bewildered mouth.",
          "src": "ALIENS_R6_CONTACT_6_2026-11-08/CHARACTER_INTENT.json",
          "status": "DESIGN"
        }
      }
