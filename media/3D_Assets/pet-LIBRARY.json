    {
      "id": "idle",
      "loop": true,
      "source": "glb",
      "desc": "ruhiges Atmen/Claymation-Wackeln, kein Idle-Fidget"
    },
    {
      "id": "roll",
      "trigger": "mode-select",
      "desc": "Pet rollt sich zum Wuerfel ein + tumbelt; obenliegende Flaeche = Story-Mode"
    },
