  "eyeRig": {
    "anchorDefault": {
      "dx": 0.345,
      "dy": -0.1,
      "ring": 0.3,
      "track": 0.1
    },
    "pupilSize": 0.4,
    "inset": 0,
    "lidFit": 0.9,
    "converge": 0,
    "lids": {
      "upper": true,
      "lower": true
    },
    "eyelidColor": "base-darkened",
    "pupilStyles": [
      "matte-cute",
      "glossy-googly"
    ],
    "gloss": {
      "matte-cute": 0.32,
      "glossy-googly": 0.85
    },
    "fx": [
      "none",
      "spiral",
      "heart"
    ],
    "blink": {
      "minGap": 2.5,
      "maxGap": 6.5,
      "dur": 0.12
    },
    "recolorDefault": "#f2c93c",
    "note": "KORR v2 (Feedback FEEDBACK_v1_to_v2.md): glossy-googly = GROESSERE + GLAENZENDE Pupillen (NICHT herausstehende Kugeln ueber den Lidern!) via pupilSize + gloss, gleiche Geometrie. pupilSize = Default-Pupillengroesse (Slider). inset = Augen tiefer in den Koerper (Slider). lidFit = wie eng die Lider die Eyeballs umschliessen (kleiner Sicherheitsabstand ok; Pupille MUSS innerhalb bleiben = KEIN Clipping). eyelidColor = abgedunkelte Base-Color des Pets. track = Pupillen-Blickwanderung (in v1 unklar/unsichtbar -> klar labeln oder streichen)."
  },
  "material": {
    "default": "clay",
    "presets": {
      "clay": {
        "base": "tint",
        "detail": "fingerprint",
        "projection": "triplanar",
