        "options": {
          "fp002": {
            "normal": "Fingerprints002_1K-JPG_NormalGL.jpg",
            "roughness": "Fingerprints002_1K-JPG_Roughness.jpg",
            "note": "dicht/gleichmaessig geknetet - bester Clay-Default"
          },
          "fp009": {
            "normal": "Fingerprints009_1K-JPG_NormalGL.jpg",
            "roughness": "Fingerprints009_1K-JPG_Roughness.jpg",
            "note": "klare Ridges, verstreut - Alternative, weniger tilen"
          },
          "fp005": {
            "normal": "Fingerprints005_1K-JPG_NormalGL.jpg",
            "roughness": "Fingerprints005_1K-JPG_Roughness.jpg",
            "note": "sehr subtil/kratzig - eher Worn/Grime-Overlay"
          }
        },
        "status": "Ordner hochgeladen als Textures/fingerprints_01/ (2026-07-14). Dateinamen = die gestagten (Fingerprints0NN_1K-JPG_NormalGL/Roughness.jpg). Hard-Verify via GitHub-UI/Chrome noch offen (web_fetch kann JPG nicht sicher pruefen); falls Files beim Upload umbenannt wurden, hier anpassen."
      },
      "fabric-worn": "TBD"
    },
    "outline": {
      "mode": "v6-inverted-hull",
      "default": false,
      "note": "3D-Outline aus KFB Table v6 (_shaderHull: Abwaerts-Extrusion + Kontakt-Band-Licht-Logik fuer Dicke) als TOGGLE ueber ALLE Presets. Default aus (Master §4, Claymation ohne Outline)."
    },
    "note": "EINE greyscale Detail-Kombo, per Triplanar/Box auf alle 24 Pets, getoent via pet.color, global tauschbar. clay = Default (Aardman-Fingerprint), felt = Preset.",
