  "eyeRig": {
    "anchorDefault": {
      "dx": 0.345,
      "dy": -0.1,
      "ring": 0.3,
      "track": 0.1
    },
    "pupilSize": 0.4,
    "inset": 0,
    "lidFit": 0.9,
    "converge": 0,
    "lids": {
      "upper": true,
      "lower": true
    },
    "eyelidColor": "base-darkened",
    "pupilStyles": [
      "matte-cute",
      "glossy-googly"
    ],
    "gloss": {
      "matte-cute": 0.1,
      "glossy-googly": 0.85
    },
    "fx": [
      "none",
      "spiral",
      "heart"
    ],
    "blink": {
      "minGap": 2.5,
      "maxGap": 6.5,
      "dur": 0.12
    },
    "recolorDefault": "#f2c93c",
    "note": "KORR v2 (Feedback FEEDBACK_v1_to_v2.md): glossy-googly = GROESSERE + GLAENZENDE Pupillen (NICHT herausstehende Kugeln ueber den Lidern!) via pupilSize + gloss, gleiche Geometrie. pupilSize = Default-Pupillengroesse (Slider). inset = Augen tiefer in den Koerper (Slider). lidFit = wie eng die Lider die Eyeballs umschliessen (kleiner Sicherheitsabstand ok; Pupille MUSS innerhalb bleiben = KEIN Clipping). eyelidColor = abgedunkelte Base-Color des Pets. track = Pupillen-Blickwanderung (in v1 unklar/unsichtbar -> klar labeln oder streichen)."
  },
  "material": {
    "default": "clay",
    "presets": {
      "clay": {
        "base": "tint",
        "detail": "fingerprint",
        "projection": "triplanar",
        "detailStrength": 0.2,
        "roughness": 0.85,
        "ao": true,
        "jitter": true
      },
      "felt": {
        "base": "tint",
        "detail": "fabric-worn",
        "projection": "triplanar",
        "detailStrength": 0.3,
        "roughness": 0.95,
        "ao": true,
        "jitter": true
      },
      "cel": {
        "base": "tint",
        "shading": "toon-bands"
      },
      "kenney": {
        "base": "glb-embedded"
      }
    },
    "detailMaps": {
      "fingerprint": {
        "default": "fp002",
        "base": "https://raw.githubusercontent.com/georg-doc/kayfabizarro/main/media/3D_Assets/Textures/fingerprints_01/",
        "use": "NormalGL als Bump (+ optional Roughness). Triplanar/Box, detailStrength ~0.1-0.2, Tiling 1-2x.",
        "options": {
          "fp002": {
            "normal": "Fingerprints002_1K-JPG_NormalGL.jpg",
            "roughness": "Fingerprints002_1K-JPG_Roughness.jpg",
            "note": "dicht/gleichmaessig geknetet - bester Clay-Default"
          },
          "fp009": {
            "normal": "Fingerprints009_1K-JPG_NormalGL.jpg",
            "roughness": "Fingerprints009_1K-JPG_Roughness.jpg",
            "note": "klare Ridges, verstreut - Alternative, weniger tilen"
          },
          "fp005": {
            "normal": "Fingerprints005_1K-JPG_NormalGL.jpg",
            "roughness": "Fingerprints005_1K-JPG_Roughness.jpg",
            "note": "sehr subtil/kratzig - eher Worn/Grime-Overlay"
          }
        },
        "status": "Ordner hochgeladen als Textures/fingerprints_01/ (2026-07-14). Dateinamen = die gestagten (Fingerprints0NN_1K-JPG_NormalGL/Roughness.jpg). Hard-Verify via GitHub-UI/Chrome noch offen (web_fetch kann JPG nicht sicher pruefen); falls Files beim Upload umbenannt wurden, hier anpassen."
      },
      "fabric-worn": "TBD"
    },
    "outline": {
      "mode": "v6-inverted-hull",
      "default": false,
      "note": "3D-Outline aus KFB Table v6 (_shaderHull: Abwaerts-Extrusion + Kontakt-Band-Licht-Logik fuer Dicke) als TOGGLE ueber ALLE Presets. Default aus (Master §4, Claymation ohne Outline)."
    },
    "note": "EINE greyscale Detail-Kombo, per Triplanar/Box auf alle 24 Pets, getoent via pet.color, global tauschbar. clay = Default (Aardman-Fingerprint), felt = Preset.",
    "live": {
      "texture": "Paper004",
      "mod": "none",
      "surf": {
        "texScale": 0.3,
        "tint": 1,
        "relief": 1.2,
        "knet": 0,
        "ao": 0.14,
        "rough": 0.9,
        "freq": 11,
        "modScale": 2,
        "modAmt": 0.55
      }
    }
