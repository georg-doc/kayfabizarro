      "id": "hopLevelUp",
      "trigger": "level-up",
      "desc": "Sprung ein Level hoch (statt Aufzug)"
    },
    {
      "id": "hopLevelDown",
      "trigger": "level-down",
      "desc": "Sprung ein Level runter"
    },
    {
      "id": "kayfabulate",
      "trigger": "narration",
      "desc": "Emote-getriebenes Erzaehlen: Augen/Lider spielen die Beats"
    }
  ],
