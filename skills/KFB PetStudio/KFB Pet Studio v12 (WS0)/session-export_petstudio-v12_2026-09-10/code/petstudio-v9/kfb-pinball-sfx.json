  "drone": {
    "note": "Prozedural, keine Dateien. R, A und F sind die drei Wuerfel: Resonanz, Amplitude, Frequenz. An den Wuerfeln sind sie nur Farbcodierung, hier sind sie wieder das, was sie bedeuten. Damit ist die 4D-Behauptung eingeloest.",
    "base": 55,
    "partials": [
      1,
      1.5,
      2,
      3
    ],
    "mapping": {
      "R": {
        "von": "roter Wuerfel",
        "auf": "Filterresonanz Q",
        "bereich": [
          0.5,
          14
        ]
      },
      "A": {
        "von": "gelber Wuerfel",
        "auf": "Grundpegel",
        "bereich": [
          0.0,
          1.0
        ]
      },
      "F": {
        "von": "blauer Wuerfel",
        "auf": "Grundfrequenz in Halbtoenen",
        "bereich": [
          -12,
          12
        ]
      }
    },
    "kopplung": "Jeder Wuerfel speist seinen Parameter aus Geschwindigkeit und Naehe zur Kartenmitte. Ruht ein Wuerfel, faellt sein Anteil weich auf null."
  }
