{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kayfabizarro.pages.dev/schemas/resident-lean-card/0.2",
  "title": "KFB Resident Lean Character Card (proposal 0.2, clamp field set)",
  "description": "High-level character clamps in the Hunky & Dory shape (structure only), plus pointers to the shared Triplet pool and the Resident profile. Every field is {v, src, status}. No dialogue lines anywhere. In-world strings English.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "residentId",
    "role",
    "body",
    "clamps",
    "cards",
    "speech",
    "memory"
  ],
  "properties": {
    "schema": {
      "const": "kfb.resident-lean-card/0.2"
    },
    "residentId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "role": {
      "enum": [
        "regular",
        "special"
      ],
      "description": "special = meta roles such as Lorekeeper (meta-archivist/mentor) or Officer Doppel-Denk (patrol/comic relief)"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "$ref": "#/$defs/f"
        },
        "rigFamily": {
          "$ref": "#/$defs/f"
        },
        "defaultPose": {
          "$ref": "#/$defs/f"
        },
        "props": {
          "$ref": "#/$defs/f"
        },
        "habitat": {
          "$ref": "#/$defs/f"
        }
      }
    },
    "archetype": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jungDrive": {
          "$ref": "#/$defs/f"
        },
        "journeyFunction": {
          "$ref": "#/$defs/f"
        },
        "frictionEngine": {
          "$ref": "#/$defs/f"
        }
      }
    },
    "clamps": {
      "type": "object",
      "additionalProperties": false,
      "description": "H&D-shaped clamp set",
      "properties": {
        "clamp": {
          "$ref": "#/$defs/f"
        },
        "method": {
          "$ref": "#/$defs/f"
        },
        "coreWant": {
          "$ref": "#/$defs/f"
        },
        "coreIrritation": {
          "$ref": "#/$defs/f"
        },
        "contradiction": {
          "$ref": "#/$defs/f"
        },
        "failureLoop": {
          "$ref": "#/$defs/f"
        },
        "fears": {
          "$ref": "#/$defs/f"
        },
        "escalationStyle": {
          "$ref": "#/$defs/f"
        },
        "hiddenGoal": {
          "$ref": "#/$defs/f"
        },
        "darkSecret": {
          "$ref": "#/$defs/f"
        },
        "speechAvoid": {
          "$ref": "#/$defs/f"
        }
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signatureDeckCandidate": {
          "$ref": "#/$defs/f"
        },
        "deckLane": {
          "$ref": "#/$defs/f"
        },
        "stance": {
          "$ref": "#/$defs/f"
        },
        "signatureCardRefs": {
          "$ref": "#/$defs/f"
        }
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languageOwner": {
          "const": "ChatterBox + shared Triplet pool"
        },
        "signatureTripletRefs": {
          "$ref": "#/$defs/f"
        },
        "relationBias": {
          "$ref": "#/$defs/f"
        },
        "transformBias": {
          "$ref": "#/$defs/f"
        },
        "preferredOperators": {
          "$ref": "#/$defs/f"
        },
        "attitudeBaseline": {
          "$ref": "#/$defs/f"
        },
        "fluffOlectBias": {
          "$ref": "#/$defs/f"
        }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moodStates": {
          "$ref": "#/$defs/f"
        },
        "closenessDefault": {
          "$ref": "#/$defs/f"
        },
        "heatDefault": {
          "$ref": "#/$defs/f"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "const": "KFB Town Resident Social Memory"
        },
        "beliefSources": {
          "$ref": "#/$defs/f"
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "f": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {},
        "src": {
          "type": "string"
        },
        "status": {
          "enum": [
            "SOURCE",
            "DESIGN",
            "PREFILL",
            "OPEN",
            "CONFLICT"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SOURCE",
                  "DESIGN",
                  "PREFILL"
                ]
              }
            }
          },
          "then": {
            "required": [
              "v",
              "src"
            ]
          }
        }
      ]
    }
  }
}