{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfb.project-story-corpus.event/1",
  "title": "KFB Project Story Corpus Event",
  "type": "object",
  "required": [
    "id",
    "time",
    "kind",
    "title",
    "facts",
    "sources",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "time": {
      "type": "object",
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "instant",
            "day",
            "range",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "origin",
        "proposal",
        "decision",
        "implementation",
        "test",
        "human_gate",
        "failure",
        "recovery",
        "postmortem",
        "deprecation",
        "publication",
        "handoff",
        "architecture_rule",
        "source_acceptance",
        "source_rejection"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "before": {
      "type": [
        "object",
        "null"
      ]
    },
    "after": {
      "type": [
        "object",
        "null"
      ]
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "status"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "status": {
            "enum": [
              "rejected",
              "deferred",
              "superseded",
              "unknown"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "consequence": {
      "type": [
        "string",
        "null"
      ]
    },
    "lesson": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "github_file",
              "github_issue",
              "github_pr",
              "github_commit",
              "site_evidence",
              "dropbox_provenance",
              "human_feedback"
            ]
          },
          "ref": {
            "type": "string"
          },
          "sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "enum": [
        "source_proven",
        "strong",
        "partial",
        "unknown"
      ]
    },
    "narrative": {
      "type": "object",
      "properties": {
        "heroBeat": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ordinary_world",
            "call",
            "refusal_or_fragmentation",
            "mentor_or_rule",
            "threshold",
            "tests_allies_enemies",
            "approach",
            "ordeal",
            "reward",
            "road_back",
            "resurrection",
            "return",
            null
          ]
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "showIt": {
          "type": [
            "string",
            "null"
          ]
        },
        "spinIt": {
          "type": [
            "string",
            "null"
          ]
        },
        "sellIt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "predecessors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "donors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
